rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // incidents/{uid}/... — authenticated users can write their own media,
    // authenticated operators can read all incident media
    match /incidents/{incidentId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == incidentId;
      allow read: if request.auth != null;
    }
  }
}
